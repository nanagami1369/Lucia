@page "/debug"
@using Lucia.Server.Client.HubClients
@rendermode InteractiveWebAssembly
@implements IDisposable
@inject IServiceProvider Services

@* 開発用デバッグページ（検証後に削除する） *@

<PageTitle>デバッグ | Lucia</PageTitle>

<h2>予約シャットダウン デバッグ</h2>

<p>
    状態:
    @if (remainingTime is null)
    {
        <span>予約なし</span>
    }
    else
    {
        <span>予約あり（残り @remainingTime.Value.ToString("hh':'mm':'ss")）</span>
    }
</p>

<p>
    <label>
        何秒後に予約するか:
        <input type="number" min="1" @bind="delaySeconds" />
    </label>
    <button @onclick="() => RegisterScheduleShutdown(delaySeconds)">予約</button>
</p>

<p>
    プリセット:
    <button @onclick="() => RegisterScheduleShutdown(6 * 60)">6分後（1分後に通知が出る）</button>
    <button @onclick="() => RegisterScheduleShutdown(5 * 60 + 15)">5分15秒後（15秒後に通知が出る）</button>
    <button @onclick="() => RegisterScheduleShutdown(4 * 60)">4分後（通知は出ない）</button>
</p>

<p>
    <button @onclick="CancelScheduleShutdown">予約キャンセル</button>
</p>

<p>@message</p>

@code {

    /// <summary>
    /// 電源管理ハブ クライアント
    /// </summary>
    private PowerHubClient? powerHubClient;

    /// <summary>
    /// 予約シャットダウンまでの残り時間。予約なしの場合は null
    /// </summary>
    private TimeSpan? remainingTime;

    /// <summary>
    /// 入力欄の予約秒数
    /// </summary>
    private int delaySeconds = 6 * 60;

    /// <summary>
    /// 操作結果のメッセージ
    /// </summary>
    private string message = "";

    /// <summary>
    /// レンダリング時
    /// </summary>
    /// <param name="firstRender">初回レンダリングかどうか</param>
    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) { return; }
        if (Services.GetService<PowerHubClient>() is { } hubClient)
        {
            powerHubClient = hubClient;
            powerHubClient.UpdateScheduleShutdown += HandleUpdateScheduleShutdown;
        }
    }

    /// <summary>
    /// 破棄処理
    /// </summary>
    public void Dispose()
    {
        if (powerHubClient != null)
        {
            powerHubClient.UpdateScheduleShutdown -= HandleUpdateScheduleShutdown;
        }
    }

    /// <summary>
    /// 予約シャットダウンの更新時に発生
    /// </summary>
    /// <param name="remainingTime">残り時間</param>
    private void HandleUpdateScheduleShutdown(TimeSpan? remainingTime)
    {
        this.remainingTime = remainingTime;
        StateHasChanged();
    }

    /// <summary>
    /// 指定秒数後にシャットダウンを予約する
    /// </summary>
    /// <param name="seconds">何秒後に予約するか</param>
    private async Task RegisterScheduleShutdown(int seconds)
    {
        if (powerHubClient is null)
        {
            message = "ハブ未接続";
            return;
        }
        var executeAt = DateTimeOffset.Now.AddSeconds(seconds);
        try
        {
            await powerHubClient.RegisterScheduleShutdown(executeAt);
            message = $"予約しました: {executeAt:HH:mm:ss}（{seconds}秒後）";
        }
        catch (Exception ex)
        {
            message = $"予約失敗: {ex.Message}";
        }
    }

    /// <summary>
    /// 現在の予約シャットダウンをキャンセルする
    /// </summary>
    private async Task CancelScheduleShutdown()
    {
        if (powerHubClient is null)
        {
            message = "ハブ未接続";
            return;
        }
        try
        {
            await powerHubClient.CancelScheduleShutdown();
            message = "キャンセルしました";
        }
        catch (Exception ex)
        {
            message = $"キャンセル失敗: {ex.Message}";
        }
    }

}
