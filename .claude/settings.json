{
  "permissions": {
    "deny": [
      "Bash(git commit*)",
      "Bash(git add*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet run hooks/git-guard/block-commit.cs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet run hooks/dotnet-format/record-edit.cs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "dotnet run hooks/dotnet-format/auto-formatter.cs"
          },
          {
            "type": "command",
            "command": "dotnet run hooks/dotnet-format/braces-enforcer.cs"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "dotnet run hooks/dotnet-format/recovery.cs"
          }
        ]
      }
    ]
  }
}
